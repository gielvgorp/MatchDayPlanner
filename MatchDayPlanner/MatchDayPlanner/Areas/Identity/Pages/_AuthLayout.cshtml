@{
    Layout = "/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/AuthStyleSheet.css" asp-append-version="true" />
<main class="w-100 h-100 d-flex justify-content-center align-items-center">
    <div class="main-container d-flex flex-column">
        <h4 class="text text-center pt-4">Welkom bij Matchday Planner!</h4>
        <div class="w-100 h-100 p-3 d-flex align-items-center render-body">
            @RenderBody()
        </div>
    </div>
</main>

@section Scripts{
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function () {
            const currentPage = location.pathname;
            $('.nav-tabs li a').each(function () {
                const $this = $(this);

                if (currentPage.toLowerCase().indexOf($this.attr('href').toLowerCase() == -1) {
                    $this.addClass('active');
                }
            })
        })
    </script>
}