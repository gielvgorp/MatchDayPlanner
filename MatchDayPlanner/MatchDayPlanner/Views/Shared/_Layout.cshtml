<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MatchDayPlanner</title>
    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MatchDayPlanner.styles.css" asp-append-version="true" />

    <!-- Font awesome -->
    <script src="https://kit.fontawesome.com/d66c1fe273.js" crossorigin="anonymous"></script>
</head>
<body>
    <header>
        <div class="header-top">
            <h3 class="title">@ViewData["Title"]</h3>
            @if (ViewData["SubTitle"] != null)
            {
                <p class="sub-title">@ViewData["SubTitle"]</p>
            }
        </div>
        <div class="header-bottom">
            <div class="header-stats-container">
                @Html.Partial("_HeaderStatsPartialView")
            </div>
            <div class="menu-items">
                @Html.Partial("_HeaderPartialView")
            </div>
        </div>
    </header>
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
