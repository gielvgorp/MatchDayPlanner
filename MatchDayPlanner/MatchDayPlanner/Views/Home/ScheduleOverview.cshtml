@{
    ViewData["Title"] = "Schema overzicht";
    ViewBag.CurrentView = "ScheduleOverview";
}

@using System.Globalization;
@using MatchDayPlanner.Models.ViewModels;
@using MatchDayPlanner.Models.ViewModels
@model ScheduleOverviewViewModel

<link rel="stylesheet" href="~/css/scheduleOverview.css" asp-append-version="true" />
<script defer src="~/js/ScheduleOverview.js"></script>

<div class="page-content">
    <div class="cal-grid">
        @{
            // Get the start and end dates
            DateTime startDate = Model.Scheme.startDate;
            DateTime endDate = Model.Scheme.endDate;

            // Calculate the total number of months between the start and end dates
            int totalMonths = ((endDate.Year - startDate.Year) * 12) + endDate.Month - startDate.Month + 1;
        }
        @for (int i = 0; i < totalMonths; i++)
        {
            DateTime currentMonth = startDate.AddMonths(i);
            <div class="call-month pb-5">
                <h3 class="text cal-month-name">@(new DateOnly(currentMonth.Year, currentMonth.Month, 1).ToString("MMMM yyyy", CultureInfo.CreateSpecificCulture("nl"))) </h3>
                <div class="cal-days">
                    @for (int y = 0; y < (int)new DateTime(currentMonth.Year, currentMonth.Month, 1).DayOfWeek - 2; y++)
                    {
                        <div class="day-cell-disabled cal-day-cell"></div>
                    }

                    @for (int x = 0; x < DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month); x++)
                    {
                        // Calculate the target date
                        var targetDate = new DateTime(currentMonth.Year, currentMonth.Month, (x + 1));
                        // Find the specific match day that matches the target date
                        var matchDay = Model.SchemeMatchDay.FirstOrDefault(m => m.matchDayDateTime.Date == targetDate.Date);
                        // Determine if a match day was found
                        bool isMatchDay = matchDay != null;

                        <div class="@(isMatchDay ? "cal-day-cell matchday" : "cal-day-cell")" data-date="@targetDate.ToString("MM/dd/yyyy")" data-matchday="@(isMatchDay ? matchDay.matchDayID : "")" data-status="@(isMatchDay ? "matchday" : "")" onclick="changeMatchDay(this, '@Model.Scheme.schemeID')">
                            <h5 class="text">@(x + 1)</h5>
                        </div>
                    }

                </div>
            </div>
        }
    </div>
</div>