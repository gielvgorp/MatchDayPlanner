@{
    ViewData["Title"] = "Team's overview";
}

@model List<TeamViewModel>

<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<div class="page-content teams">
    @foreach (TeamViewModel team in Model)
    {
        <div class="team-container">
            <h6 class="team-name text">@team.teamName</h6>
            <p class="members text">@team.members.Count Leden</p>
            <div class="manage-team text">
                <a class="text" href="@Url.Action("ManageTeam", "Home", new { teamID = team.teamID, add = false})">
                    <i class="fa-solid fa-ellipsis-vertical"></i>
                </a>
            </div>
        </div>
    }
</div>
