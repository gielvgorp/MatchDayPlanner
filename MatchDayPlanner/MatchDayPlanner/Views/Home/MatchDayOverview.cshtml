@{
    ViewData["Title"] = "Wedstrijddag overzicht";
}
@using MatchDayPlanner.Models.ViewModels
@model MatchDayOverviewModel
<link rel="stylesheet" href="~/css/matchDayOverview.css" asp-append-version="true" />
<div class="main-content">
    <div class="matchday-status-container">
        <div class="status-item">
            <span class="name">Aanwezig: </span>
            <span>@(Model.PreventionList.Where(p => p.IsPresent == MemberPrevention.PreventionStatus.Available)?.Count() == null ? "0" : Model.PreventionList.Where(p => p.IsPresent == MemberPrevention.PreventionStatus.Available)?.Count().ToString())</span>
        </div>
         <div class="status-item">
            <span class="name">Afwezig: </span>
            <span>@(Model.PreventionList.Where(p => p.IsPresent == MemberPrevention.PreventionStatus.Unavailable).Count() == null ? "0" : Model.PreventionList.Where(p => p.IsPresent == MemberPrevention.PreventionStatus.Unavailable).Count().ToString())</span>
        </div>
        <div class="status-item">
            <span class="name">Niet gereageerd: </span>
            <span>@(Model.PreventionList.Where(p => p.IsPresent == MemberPrevention.PreventionStatus.NoResponse).Count() == null ? "0" : Model.PreventionList.Where(p => p.IsPresent == MemberPrevention.PreventionStatus.NoResponse).Count().ToString())</span>
        </div>
    </div>
    <div class="prevention-main-container">
        <div class="prevention-list-container">
            @if (Model.PreventionList.Count > 0)
            {
                @foreach (var item in Model.PreventionList)
                {
                    <div class="prevention-list-item @if (item.IsPresent == MemberPrevention.PreventionStatus.Available) @("available") else if(item.IsPresent == MemberPrevention.PreventionStatus.Unavailable) @("unavailable")">
                        <i class="fa-solid fa-user"></i>
                        <p>@item.TeamMember.memberName | @if (item.IsPresent == MemberPrevention.PreventionStatus.Available) @("Aanwezig") else if(item.IsPresent == MemberPrevention.PreventionStatus.Unavailable) @("Afwezig") else @("Niet gereageerd")</p>
                    </div>
                }
            }
            else
            {
                <h4 style="color: white; font-family: var(--font)">Geen resultaat!</h4>
            }
        </div>
        <div class="legenda-container">
            <h5 class="title">Legenda</h5>
            <div class="legenda-item">
                <div class="legenda-color legenda-available"></div>
                <span>Beschikbaar</span>
            </div>
            <div class="legenda-item">
                <div class="legenda-color legenda-unavailable"></div>
                <span>Niet beschikbaar</span>
            </div>
            <div class="legenda-item unknown">
                <div class="legenda-color"></div>
                <span>Onbekend</span>
            </div>
        </div>
    </div>
</div>