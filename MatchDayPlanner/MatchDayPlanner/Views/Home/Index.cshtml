@{
    ViewData["Title"] = "Home Page";
}

@model LoginSignUpViewModel

<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/index.js" defer></script>
<div class="w-100 d-flex justify-content-center align-items-center" style="height: 100vh">
    <div class="main-container d-flex align-self-center flex-column pb-5">
        <div class="login-head w-100 d-flex justify-content-evenly align-items-center">
            <div data-type="signin">
                <h5>Inloggen</h5>
            </div>
            <div data-type="signup">
                <h5>Registreren</h5>
            </div>
            <div class="head-strip" data-selected="signin"></div>
        </div>
        <div class="w-75 mx-auto mt-3" id="signin-form">
            @using (Html.BeginForm("Index", "Home", FormMethod.Post))
            {
                <div class="form-group mt-2">
                    <label for="email-input">Email adres</label>
                    @Html.TextBoxFor(m => m.loginModel.UserEmailAddress, new { @class = "form-control", placeholder = "John@doe.com" })
                </div>
                <div class="form-group mt-2">
                    <label for="password-input">Wachtwoord</label>
                    @Html.TextBoxFor(m => m.loginModel.UserPassword, new { @class = "form-control", placeholder = "**********", type = "password" })
                </div>
                <div class="row mt-4">
                    <div class="col d-flex justify-content-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="form2Example31" checked />
                            <label class="form-check-label" for="form2Example31"> Remember me </label>
                        </div>
                    </div>
                    <div class="col">
                        <a href="#!">Forgot password?</a>
                    </div>
                </div>
                <div class="form-group mt-2">
                    <input type="submit" class="btn btn-primary w-100" value="Inloggen" />
                </div>
            }
        </div>
        <div class="w-75 mx-auto mt-3" id="signup-form">
            @using (Html.BeginForm("Index", "Home", FormMethod.Post))
            {
                <div class="form-group mt-2">
                    <label for="email-input">Volledige naam</label>
                    @Html.TextBoxFor(m => m.signupModel.FullName, new { @class = "form-control", placeholder = "John Doe" })
                    <span asp-validation-for="signupModel.FullName" class="text-danger"></span>
                </div>
                <div class="form-group mt-2">
                    <label for="email-input">Email adres</label>
                    @Html.TextBoxFor(m => m.signupModel.EmailAddress, new { @class = "form-control", placeholder = "John@doe.com" })
                    <span asp-validation-for="signupModel.EmailAddress" class="text-danger"></span>
                </div>
                <div class="form-group mt-2">
                    <label for="password-input">Wachtwoord</label>
                    @Html.TextBoxFor(m => m.signupModel.Password, new { @class = "form-control", placeholder = "**********", type = "password" })
                    <span asp-validation-for="signupModel.Password" class="text-danger"></span>
                </div>
                <div class="form-group mt-2">
                    <label for="password-input">Wachtwoord</label>
                    @Html.TextBoxFor(m => m.signupModel.ConfirmPassword, new { @class = "form-control", placeholder = "**********", type = "password" })
                    <span asp-validation-for="signupModel.ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="form-group mt-2">
                    <input type="submit" class="btn btn-primary w-100" value="Registreren" />
                </div>
            }
        </div>
    </div>
</div>


