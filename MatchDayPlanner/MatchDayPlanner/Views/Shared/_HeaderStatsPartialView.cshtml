@using System.Globalization
@if(ViewBag.CurrentView == "Index")
{
    <div class="stats-item">
        <p class="name">Aantal teams:</p>
        <p class="value">@ViewBag.NumberOfTeams</p>
    </div>
}else if(ViewBag.CurrentView == "ManageTeam")
{
    <div class="stats-item">
        <p class="name">Aantal spelers:</p>
        <p class="value">@ViewBag.NumberOfPlayers</p>
    </div>
    <div class="stats-item">
        <p class="name">Team captain:</p>
        <p class="value">@ViewBag.CaptainName</p>
    </div>
    <div class="stats-item">
        <p class="name">Aantal schema's:</p>
        <p class="value">@ViewBag.NumberOfSchemes</p>
    </div>
}
else if (ViewBag.CurrentView == "ScheduleOverview")
{
    <div class="stats-item">
        <p class="name">Deadline:</p>
        <p class="value">@ViewBag.SchemeDeadline</p>
    </div>
    <div class="stats-item">
        <p class="name">Schema status:</p>
        <p class="value">@if (ViewBag.SchemeStatus == 1) @("Gepubliceerd") else @("Niet gepubliceerd")</p>
    </div>
}
else if (ViewBag.CurrentView == "SchemePrevention")
{
    <div class="stats-item">
        <p class="name">Deadline:</p>
        <p class="value">@ViewBag.SchemeDeadline</p>
    </div>
}
else if (ViewBag.CurrentView == "MatchdayOverview")
{
    <div class="stats-item">
        <p class="name"><i class="fa-solid fa-location-dot pe-2"></i> @if (string.IsNullOrEmpty(ViewBag.location)) @("Locatie onbekend") else @(ViewBag.location)</p>
    </div>
    <div class="stats-item">
        <p class="name"><i class="fa-solid fa-calendar-xmark pe-2"></i> @if (ViewBag.DateTime.ToString("HH:mm") != "00:00"){ @(ViewBag.DateTime.ToString("HH:mm") + "-") } @(new DateOnly(ViewBag.DateTime.Year, ViewBag.DateTime.Month, ViewBag.DateTime.Day).ToString("dd MMMM yyyy", CultureInfo.CreateSpecificCulture("nl")))</p>
    </div>
}