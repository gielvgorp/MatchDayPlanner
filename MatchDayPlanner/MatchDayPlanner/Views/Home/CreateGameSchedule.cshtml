@{
    ViewData["Title"] = "Nieuw schema maken";
}


@model CreateScheduleViewModel
<link rel="stylesheet" href="~/css/createTeam.css" asp-append-version="true" />
<div class="page-content teams">
    <div class="form-container">
        <h4 class="text">Voer hieronder de informatie in</h4>
        @using (Html.BeginForm("CreateGameSchedule", "Home", FormMethod.Post))
        {
            @Html.HiddenFor(m => m.TeamID)
            <div class="form-group">
                @Html.LabelFor(m => m.ScheduleName, new { @class = "text" })
                @Html.TextBoxFor(m => m.ScheduleName, new { @class="form-control" })
                <span asp-validation-for="ScheduleName" class="text-danger pt-1"></span>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.numberOfPresent, new { @class = "text" })
                @Html.TextBoxFor(m => m.numberOfPresent, new { @class = "form-control" })
                <span asp-validation-for="numberOfPresent" class="text-danger pt-1"></span>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Deadline, new { @class = "text" })
                @Html.TextBoxFor(m => m.Deadline, new { @class = "form-control", type = "date" })
                <span asp-validation-for="Deadline" class="text-danger pt-1"></span>
            </div>
            <div class="form-group row mx-0 justify-content-between">
                <div class="col-5 px-0">
                    @Html.LabelFor(m => m.DateStart, new { @class = "text" })
                    @Html.TextBoxFor(m => m.DateStart, new { @class = "form-control", type = "date" })
                    <span asp-validation-for="DateStart" class="text-danger pt-1"></span>
                </div>
                <div class="col-5 px-0">
                    @Html.LabelFor(m => m.DateEnd, new { @class = "text" })
                    @Html.TextBoxFor(m => m.DateEnd, new { @class = "form-control", type = "date" })
                    <span asp-validation-for="DateEnd" class="text-danger pt-1"></span>
                </div>
            </div>
            <div class="form-group">
               
            </div>
            <button class="text">Aanmaken</button>
        }
    </div>
</div>
