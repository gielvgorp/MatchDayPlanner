@using MatchDayPlanner.Models.ViewModels
@model TeamMemberViewModel

@{
    ViewData["Title"] = "Speler bewerken";
}
<link rel="stylesheet" href="~/css/editPlayer.css" asp-append-version="true" />

<div class="page-content">
    @using (Html.BeginForm("EditPlayer", "Team", FormMethod.Post))
    {
        <div class="form-container p-4">
            <div class="form-group">
                @Html.LabelFor(m => m.memberName, new { @class = "form-label text" })
                @Html.TextBoxFor(m => m.memberName, new { @class = "form-control", aria_describedby = "emailHelp", placeholder = "Full name" })
            </div>
            <div class="form-group mt-3">
                @Html.LabelFor(m => m.memberEmail, new { @class = "form-label text" })
                @Html.TextBoxFor(m => m.memberEmail, new { @class = "form-control", aria_describedby = "emailHelp", placeholder = "Email address" })
            </div>
            <div class="form-group form-check mt-3">
                <input type="checkbox" name="isCaptain" class="form-check-input" id="ckb-iscaptain">
                <label class="form-check-label text" for="ckb-iscaptain">Is team captain</label>
            </div>
            <div class="form-group row mt-3">
                <div class="form-group col-6">
                    <button class="btn btn-primary w-100" name="submitButton" value="save" type="submit">Opslaan</button>
                </div>
                <div class="form-group col-6">
                    <button class="btn btn-danger w-100" name="submitButton" value="delete" type="submit">Verwijder</button>
                </div>
            </div>
        </div>
    }
</div>