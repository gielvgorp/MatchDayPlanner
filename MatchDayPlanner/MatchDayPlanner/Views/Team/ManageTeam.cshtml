@using MatchDayPlanner.Models.ViewModels
@model TeamViewModel

@{
    ViewData["Title"] = "Team beheren";
    ViewBag.CanEdit = true;
    ViewBag.EditURL = Url.Action("EditTeam", "Team", new { teamID = Model.teamID });
}
<link rel="stylesheet" href="~/css/manageTeam.css" asp-append-version="true" />

<div class="page-content players pb-2">
    @foreach (TeamMemberViewModel member in Model.members.OrderByDescending(m => m.memberID == Model.teamCaptainID))
    {
        <div class="player-container">
            <h6 class="player-name text">
                @member.memberName
                <span class="player-role">@if (member.memberID == Model.teamCaptainID) @("Captain") else @("Speler") </span>
            </h6>
            <p class="player-email text">@member.memberEmail</p>
            <div class="manage-player text">
                <a class="text" href="@Url.Action("EditPlayer", "Team", new { memberID = member.memberID, teamID = Model.teamID })">
                    <i class="fa-solid fa-ellipsis-vertical"></i>
                </a>
            </div>
        </div>
    }

    @if (ViewBag.AddPlayer)
    {
        @using (Html.BeginForm("AddPlayer", "Team", FormMethod.Post, new { @style = "width: 100%"}))
        {
            <div class="player-container add-player">
                <input name="playerName" class="text" placeholder="John Doe" autocomplete="off" />
                <input name="playerEmail" class="text" placeholder="Johndoe@example.com" autocomplete="off" />
                <input name="teamID" value="@ViewBag.TeamID" type="hidden" />
                <div class="submit text">
                    <button class="text">Toevoegen</button>
                </div>
            </div>
        }
    }
</div>