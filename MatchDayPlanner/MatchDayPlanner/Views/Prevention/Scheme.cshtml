@using MatchDayPlanner.Models.ViewModels
@using System.Globalization
@model PreventionSchemeViewModel

@{
    ViewData["Title"] = "Schema";
}

<link rel="stylesheet" href="~/css/scheduleOverview.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/matchDayOverview.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/GeneratedScheme.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/prevention.css" asp-append-version="true" />
<script defer src="~/js/SchemeView.js"></script>

<div class="main-content d-flex justify-content-center align-items-center position-relative m-auto overflow-auto" style="flex: 1; overflow: hidden">
    <div class="prevention-main-container w-50 h-50 mt-0" id="wizard">
        <div class="prevention-main-content d-flex flex-column">
            <div class="step-wizard f-center" data-step="1" style="flex-direction: column">
                <div class="form-group w-75 m-auto">
                    <h6 class="text">Wat is je naam?</h6>
                    <select id="player-select" class="form-select mt-2">
                        @foreach (TeamMemberViewModel player in Model.Team.members)
                        {
                            <option value="@player.memberID">@player.memberName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="prevention-bottom">
                <button id="prevention-next-btn" onclick="nextStep('@Model.schemeID')">Volgende</button>
            </div>
        </div>
    </div>

    <div class="position-absolute start-0 top-0" id="cal-grid" style="display: none">
        <div class="cal-grid py-3" style="grid-template-columns: repeat(2, 600px);">
            @{
                // Get the start and end dates
                DateTime startDate = Model.Scheme.startDate;
                DateTime endDate = Model.Scheme.endDate;

                // Calculate the total number of months between the start and end dates
                int totalMonths = ((endDate.Year - startDate.Year) * 12) + endDate.Month - startDate.Month + 1;
            }

            @for (int i = 0; i < totalMonths; i++)
            {
                DateTime currentMonth = startDate.AddMonths(i);
                <div class="call-month pb-3">
                    <h3 class="text cal-month-name">@(new DateOnly(currentMonth.Year, currentMonth.Month, 1).ToString("MMMM yyyy", CultureInfo.CreateSpecificCulture("nl"))) </h3>
                    <div class="cal-days">
                        @for (int y = 0; y < (int)new DateTime(currentMonth.Year, currentMonth.Month, 1).DayOfWeek - 2; y++)
                        {
                            <div class="day-cell-disabled cal-day-cell"></div>
                        }

                        @for (int x = 0; x < DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month); x++)
                        {
                            <div class="cal-day-cell" data-date="@currentMonth.ToString("MM/dd/yyyy")">
                                <h5 class="text">@(x + 1)</h5>
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
        <div class="w-100 position-relative pb-3">
            <h3 class="text" style="padding-bottom: 20px !important;">Feedback</h3>
            @foreach (var feedback in Model.SchemeFeedbacks)
            {
                <div class="feedback-container ps-2 pb-3">
                    <div class="d-flex gap-2 align-items-center">
                        <h6 class="text">@feedback.teamMember.memberName</h6>
                        <span class="text text-secondary"> - @(new DateOnly(feedback.feedbackDateTime.Year, feedback.feedbackDateTime.Month, feedback.feedbackDateTime.Day).ToString("dd MMMM yyyy", CultureInfo.CreateSpecificCulture("nl"))) @feedback.feedbackDateTime.ToString("HH:mm")</span>
                    </div>
                    <p class="w-50 text-white fw-light">
                        @feedback.feedbackMessage
                    </p>
                    <hr class="text-white w-50" />
                </div>
            }
            
            @using (Html.BeginForm("SaveFeedback", "prevention", FormMethod.Post))
            {
                <div class="form-group">
                    @Html.HiddenFor(m => m.schemeID)
                    <input name="memberID" value="" id="feedback-memberid" type="hidden" />
                    @Html.LabelFor(m => m.schemeFeedback.feedbackMessage, new { @class = "form-label text pt-2" })
                    @Html.TextAreaFor(m => m.schemeFeedback.feedbackMessage, new { @class = "form-control w-50", @name = "feedback" })
                </div>
                <div class="form-group pt-3">
                    <button class="btn btn-primary">Feedback plaatsen</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>