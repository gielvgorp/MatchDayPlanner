@using MatchDayPlanner.Models.ViewModels
@using System.Globalization
@model GeneratedSchemeViewModel

@{
    ViewData["Title"] = "Gemaakte schema";
    ViewBag.Members = Model.team.members;
    ViewBag.Matchdays = Model.matchDays;

    ViewBag.CurrentView = "GeneratedSchemeOverview";
}

<link rel="stylesheet" href="~/css/matchDayOverview.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/GeneratedScheme.css" asp-append-version="true" />
<script src="~/js/ScheduleOverview.js" defer></script>
<script src="~/js/GeneratedScheme.js" defer></script>
<div class="main-content" style="flex: 1; overflow: hidden">
    <div class="prevention-main-container mt-0" style="max-height: 100%">
        <div class="prevention-list-container overflow-auto col-10 custom-scrollbar">
            @if (Model.matchDays.Count > 0)
            {
                <form asp-action="SaveScheme" asp-controller="Schedule" method="post" id="scheme-form">
                    <input type="hidden" name="schemeID" value="@Model.SchemeID" />
                    <input type="hidden" name="team.teamID" value="@Model.team.teamID" />
                    @for (int i = 0; i < Model.matchDays.Count; i++)
                    {
                        var matchday = Model.matchDays.OrderBy(md => md.matchDayDateTime.Date).ToList()[i];
                        <input type="hidden" name="matchDays[@i].matchDayID" value="@matchday.matchDayID" />
                        <input type="hidden" name="matchDays[@i].matchDayDateTime" value="@matchday.matchDayDateTime" />

                        <div>
                            <h4 style="color: white; font-family: var(--font)" class="fw-bold mt-3">
                                @(new DateOnly(matchday.matchDayDateTime.Year, matchday.matchDayDateTime.Month, matchday.matchDayDateTime.Day).ToString("dd MMMM yyyy", CultureInfo.CreateSpecificCulture("nl")))
                            </h4>
                            @{
                                var sortedSchemeLayout = matchday.schemeLayout.OrderByDescending(x => x.memberPrevention).ToList();
                            }

                            @for (int j = 0; j < sortedSchemeLayout.Count; j++)
                            {
                                <div class="prevention-list-item mt-3 matchday" onclick="changeMemberPrevention(this)">
                                    <i class="fa-solid fa-user"></i>
                                    <p>
                                        @sortedSchemeLayout[j].memberName | @if (sortedSchemeLayout[j].memberPrevention == SchemeTeamMember.PreventionStatus.Available)
                                            @("Aanwezig")
                                        else if (sortedSchemeLayout[j].memberPrevention == SchemeTeamMember.PreventionStatus.NotAvailable)
                                            @("Afwezig")
                                        else if (sortedSchemeLayout[j].memberPrevention == SchemeTeamMember.PreventionStatus.Scheduled)
                                            @("Ingepland")
                                        else
                                            @("Niet gereageerd")
                                    </p>
                                    <input type="hidden" id="prevention-status" name="matchDays[@i].schemeLayout[@j].memberPrevention" value="@sortedSchemeLayout[j].memberPrevention" />
                                    <input type="hidden" name="matchDays[@i].schemeLayout[@j].memberName" value="@sortedSchemeLayout[j].memberName" />
                                    <input type="hidden" name="matchDays[@i].schemeLayout[@j].memberID" value="@sortedSchemeLayout[j].memberID" />
                                </div>
                            }

                           @*  Uncomment and adjust if you need to handle notResponseMembers as well *@
                            @for (int m = 0; m < matchday.notResponseMembers.Count; m++)
                            {
                                <div class="prevention-list-item unknown" onclick="changeMemberPrevention(this)">
                            <i class="fa-solid fa-user"></i>
                            <p>
                                @sortedSchemeLayout[m].memberName | @if (sortedSchemeLayout[m].memberPrevention == SchemeTeamMember.PreventionStatus.Available)
                                    @("Aanwezig")
                                        else if (sortedSchemeLayout[m].memberPrevention == SchemeTeamMember.PreventionStatus.NotAvailable)
                                    @("Afwezig")
                                        else if (sortedSchemeLayout[m].memberPrevention == SchemeTeamMember.PreventionStatus.Scheduled)
                                    @("Ingepland")
                                else
                                    @("Niet gereageerd")

                            </p>
                                    <input type="hidden" id="prevention-status" name="matchDays[@i].schemeLayout[@m].memberPrevention" value="@sortedSchemeLayout[m].memberPrevention" />
                            <input type="hidden" name="matchDays[@i].schemeLayout[@m].memberName" value="@sortedSchemeLayout[m].memberName" />
                            <input type="hidden" name="matchDays[@i].schemeLayout[@m].memberID" value="@sortedSchemeLayout[m].memberID" />
                            <p> | Niet gereageerd</p>
                            </div>
                            }
                        </div>
                    }
                </form>
            }
            else
            {
                <h4 style="color: white; font-family: var(--font)">Geen resultaat!</h4>
            }
        </div>
        <div class="col-2 d-flex flex-column justify-content-between">
            <div class="legenda-container" style="height: 90% !important;">
                <h5 class="title">Legenda</h5>
                <div class="legenda-item" data-status="Scheduled">
                    <div class="legenda-color matchday"></div>
                    <span>Ingepland</span>
                </div>
                <div class="legenda-item" data-status="Reserve">
                    <div class="legenda-color legenda-available"></div>
                    <span>Reserve</span>
                </div>
                <div class="legenda-item" data-status="NotAvailable">
                    <div class="legenda-color legenda-unavailable"></div>
                    <span>Niet beschikbaar</span>
                </div>
                <div class="legenda-item" data-status="NoResponse">
                    <div class="legenda-color unknown"></div>
                    <span>Onbekend</span>
                </div>
            </div>
        </div>
       
    </div>
</div>

<!-- SweetAlert2 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>

