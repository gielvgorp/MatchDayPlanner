@using MatchDayPlanner.Models.ViewModels
@model SchemeMatchDayViewModel

@{
    ViewData["Title"] = "Speler bewerken";
}
<link rel="stylesheet" href="~/css/editPlayer.css" asp-append-version="true" />

<div class="page-content">
    @using (Html.BeginForm("EditMatchday", "Schedule", FormMethod.Post))
    {
        @Html.HiddenFor(m => m.schemeID)
        @Html.HiddenFor(m => m.matchDayID)
        <div class="form-container p-4">
            <div class="form-group">
                @Html.LabelFor(m => m.matchDayDateTime, new { @class = "form-label text" })
                <input type="time" class="form-control" autocomplete="off" name="matchdayTime" value="@Model.matchDayDateTime.ToString("HH:mm")" />
            </div>
            <div class="form-group mt-3">
                @Html.LabelFor(m => m.location, new { @class = "form-label text" })
                @Html.TextBoxFor(m => m.location, new { @class = "form-control", aria_describedby = "emailHelp", placeholder = "Locatie van wedstrijd", autocomplete = "off" })
            </div>
            <div class="form-group row mt-3">
                <div class="form-group col-12">
                    <button class="btn btn-primary w-100" name="submitButton" value="save" type="submit">Opslaan</button>
                </div>
            </div>
        </div>
    }
</div>